<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@id/bottomContainer">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@color/white">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:tint="@color/skyport_navy"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Choose Payment Method"
                android:textColor="@color/skyport_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>

        <!-- Step indicator (Matches Image 1: Filled Circle, Line, Empty, Line, Empty) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingBottom="8dp">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/ic_step_filled_circle" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/skyport_navy" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/ic_step_empty_circle" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/skyport_navy" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/ic_step_empty_circle" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/skyport_field_line" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Dynamic Container for Saved Cards -->
                <LinearLayout
                    android:id="@+id/llPaymentOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Add New Payment Method Row -->
                <LinearLayout
                    android:id="@+id/rowAddNewMethod"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+ Add New Payment Method"
                        android:textColor="@color/skyport_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbAddNew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:buttonTint="@color/skyport_navy"
                        android:clickable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/skyport_field_line" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Container fixed at bottom -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Are you having problems with this\npayment? "
                android:textColor="@color/skyport_navy"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get help."
                android:textColor="@color/skyport_navy"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Selected method summary matching Image 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_summary_payment"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivSelectedIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_credit_card" />

            <TextView
                android:id="@+id/tvSelectedMethod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Visa"
                android:textColor="@color/skyport_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs "
                android:textColor="@color/skyport_navy"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6000.000"
                android:textColor="@color/skyport_navy"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToPayment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Go to Payment"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gradient_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>

</RelativeLayout>
