<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="?attr/homeAsUpIndicator"
            android:tint="@color/skyport_navy" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            android:text="My Profile"
            android:textColor="@color/skyport_navy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp"
                android:background="@color/skyport_navy">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivEditAvatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_avatar"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <TextView
                    android:id="@+id/btnChangePicture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Picture"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>

            <!-- Fields -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Full Name" android:textColor="@color/skyport_label_gray"
                android:textSize="12sp" android:layout_marginTop="20dp" android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="14dp"
                android:inputType="textPersonName"
                android:textColor="@color/skyport_navy"
                android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email" android:textColor="@color/skyport_label_gray"
                android:textSize="12sp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="14dp"
                android:inputType="textEmailAddress"
                android:enabled="false"
                android:textColor="@color/skyport_label_gray"
                android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Phone Number" android:textColor="@color/skyport_label_gray"
                android:textSize="12sp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="14dp"
                android:inputType="phone"
                android:textColor="@color/skyport_navy"
                android:textSize="14sp" />

            <!-- Update Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_signup"
                android:text="Update My Profile"
                android:textAllCaps="false"
                android:textColor="@color/skyport_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
