<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F0F2F5">

    <!-- Top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:background="@color/white">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_back" android:tint="@color/skyport_navy"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Input Payment Details" android:textColor="@color/skyport_navy"
            android:textSize="18sp" android:textStyle="bold" android:gravity="center"/>
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>

    <!-- Step indicator (step 3 active) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center" android:orientation="horizontal"
        android:background="@color/white" android:paddingBottom="8dp">
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/ic_step_active"/>
        <View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/skyport_navy" android:layout_marginHorizontal="4dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/ic_step_active"/>
        <View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/skyport_navy" android:layout_marginHorizontal="4dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/ic_step_active"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Animated card preview (hidden for UPI/Amazon Pay in code) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreviewView"
                android:layout_width="match_parent"
                android:layout_height="180dp" android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp" app:cardElevation="6dp"
                app:cardBackgroundColor="@color/skyport_navy">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:padding="20dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@drawable/ic_credit_card" android:tint="@color/white"
                        android:layout_gravity="start"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:id="@+id/tvCardNumberPreview"
                        android:text="1234  5678  9123  1237"
                        android:textColor="@color/white" android:textSize="18sp"
                        android:textStyle="bold" android:layout_marginTop="18dp"
                        android:letterSpacing="0.1" android:fontFamily="monospace"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="14dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:id="@+id/tvCardNamePreview"
                            android:text="YOUR NAME" android:textColor="@color/white"
                            android:textSize="14sp" android:textAllCaps="true"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tvCardExpiryPreview"
                            android:text="00/00" android:textColor="@color/white" android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card fields (shown for Credit/Debit) -->
            <LinearLayout android:id="@+id/cardFields" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Card Number" android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardNumber" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:maxLength="19"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:hint="MM/YY" android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExpiry" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number" android:maxLength="5"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:hint="CVV"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCvv" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="4"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Name on Card" android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardName" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textPersonName"/>
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox android:id="@+id/cbSaveCard" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Remember this card"
                    android:textColor="@color/skyport_navy" android:buttonTint="@color/skyport_navy"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>

            <!-- UPI section (shown for UPI) -->
            <LinearLayout
                android:id="@+id/upiSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/upiField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Enter UPI ID (e.g. name@upi)"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUpiId" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textEmailAddress"/>
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox android:id="@+id/cbRememberUpi" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Remember this UPI ID"
                    android:textColor="@color/skyport_navy" android:buttonTint="@color/skyport_navy"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>

            <!-- Amazon Pay section -->
            <LinearLayout
                android:id="@+id/amazonPayView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You will complete payment via Amazon Pay."
                    android:textColor="@color/skyport_navy"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <CheckBox android:id="@+id/cbRememberAmazon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Remember Amazon Pay"
                    android:textColor="@color/skyport_navy" android:buttonTint="@color/skyport_navy"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>

            <!-- Selected method summary -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_credit_card" android:tint="@color/skyport_navy"/>
                    <TextView android:id="@+id/tvMethodLabel" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="12dp" android:text="Credit Card"
                        android:textColor="@color/skyport_navy" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvTotalAmount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="₹ 6,000.00"
                        android:textColor="@color/skyport_navy" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnConfirm" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_margin="16dp"
        android:text="Confirm" android:textColor="@color/white"
        android:textSize="16sp" android:textStyle="bold"
        android:backgroundTint="@color/skyport_navy" android:stateListAnimator="@null"/>
</LinearLayout>
