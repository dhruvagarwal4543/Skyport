<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_payment_card_grey"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_payment_icon_white"
        android:gravity="center">
        <ImageView
            android:id="@+id/ivCardIcon"
            android:layout_width="36dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_credit_card" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCardType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VISA"
            android:textColor="@color/skyport_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tvCardLast4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*** 1237"
            android:textColor="@color/skyport_navy"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_nav_arrow_right"
        app:tint="@color/skyport_navy" />

</LinearLayout>
