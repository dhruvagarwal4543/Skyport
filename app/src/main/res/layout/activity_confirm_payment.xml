<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F0F2F5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:background="@color/white">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_back" android:tint="@color/skyport_navy"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Confirm Details" android:textColor="@color/skyport_navy"
            android:textSize="18sp" android:textStyle="bold" android:gravity="center"/>
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Airport image placeholder -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="160dp" android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp" app:cardElevation="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/airport_map" android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>

            <!-- Flight summary card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:id="@+id/tvConfirmAirport"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Delhi Airport (DEL)" android:textColor="@color/skyport_navy"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="DEPARTURE" android:textColor="@color/skyport_label_gray" android:textSize="10sp"/>
                            <TextView android:id="@+id/tvConfirmDep"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="18:55 – 21:40" android:textColor="@color/skyport_navy"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="FARE" android:textColor="@color/skyport_label_gray" android:textSize="10sp"/>
                            <TextView android:id="@+id/tvConfirmFare"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹ 6,000.00" android:textColor="@color/skyport_navy"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment method summary -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/ivConfirmPayIcon" android:layout_width="24dp"
                        android:layout_height="24dp" android:src="@drawable/ic_credit_card"
                        android:tint="@color/skyport_navy"/>
                    <TextView android:id="@+id/tvConfirmMethod" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="12dp" android:text="Credit Card"
                        android:textColor="@color/skyport_navy" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvConfirmTotal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="₹ 6,000.00"
                        android:textColor="@color/skyport_navy" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnComplete" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_margin="16dp"
        android:text="Complete" android:textColor="@color/white"
        android:textSize="16sp" android:textStyle="bold"
        android:backgroundTint="@color/skyport_navy" android:stateListAnimator="@null"/>
</LinearLayout>
