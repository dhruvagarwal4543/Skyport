<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skyport">
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.HomeActivity" android:exported="false" />
        <activity android:name=".activities.SignupActivity" android:exported="false" />
        <activity android:name=".activities.AuthActivity" android:exported="false" />
        <activity android:name=".activities.AirportSearchActivity" android:exported="false" />
        <activity android:name=".activities.CompleteProfileActivity" android:exported="false" />
        <activity android:name=".activities.FlightListActivity" android:exported="false" />
        <activity android:name=".activities.MyAccountActivity" android:exported="false" />
        <activity android:name=".activities.EditProfileActivity" android:exported="false" />
        <activity android:name=".activities.MyTicketsActivity"  android:exported="false" />
        <activity android:name=".activities.TicketDetailActivity" android:exported="false" />
        <activity android:name=".activities.QRActivity"         android:exported="false" />
        <activity android:name=".activities.ChoosePaymentActivity"   android:exported="false" />
        <activity android:name=".activities.InputPaymentActivity"    android:exported="false" />
        <activity android:name=".activities.ConfirmPaymentActivity"  android:exported="false" />
        <activity android:name=".activities.BookingConfirmedActivity" android:exported="false" />
        <activity android:name=".activities.BookingFailedActivity"   android:exported="false" />
    </application>

</manifest>